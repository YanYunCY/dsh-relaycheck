    "deepseek-harness",
    "relaycheck",
    "llm",
    "relay"
  ],
  "license": "MIT",
  "author": "YanYunCY",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YanYunCY/dsh-relaycheck.git"
  },
  "engines": {
